# =============================================================================
# BigScore Admin Panel — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For production, configure these in Vercel Project Settings.
# Never commit .env.local or any file containing secrets.
# =============================================================================

# ─── Firebase Client SDK (public — prefixed NEXT_PUBLIC_) ────────────────────
# These are safe to expose to the browser.
# Find them in: Firebase Console → Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (private — NO NEXT_PUBLIC_ prefix) ───────────────────
# These must NEVER be exposed to the browser.
# Find them in: Firebase Console → Project Settings → Service Accounts → Generate new private key
# For Vercel: paste the entire JSON key content into a single env var or use individual fields.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase Emulators (local development only) ─────────────────────────────
# Set to "true" when running the Firebase Emulator Suite locally.
# Set to "false" or remove in production.
# Vercel production: this env var should NOT be set.

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ─── Vercel (optional) ───────────────────────────────────────────────────────
# VERCEL_URL=           # Automatically set by Vercel
# VERCEL_ENV=           # "production" | "preview" | "development" (auto-set)

# ─── GitHub Image Upload (alternative to Firebase Storage) ───────────────────
# Set these to use GitHub instead of Firebase Storage for image hosting.
# Images will be committed to your repo and served via raw.githubusercontent.com.
#
# How to create a token:
#   1. Go to: https://github.com/settings/tokens?type=beta
#   2. Create a "Fine-grained personal access token"
#   3. Give it access to your repo with "Contents" read/write permission
#   4. Paste the token below

GITHUB_IMAGE_UPLOAD_TOKEN=
GITHUB_IMAGE_REPO_OWNER=itsmama22-ctrl
GITHUB_IMAGE_REPO_NAME=BigScore
GITHUB_IMAGE_BRANCH=main
GITHUB_IMAGE_BASE_PATH=public/images/packages

# ─── News API (newsdata.io) ───────────────────────────────────────────────────
# For automatic football news syncing.
# Free tier: 100 requests/day. We sync every 6 hours = 4 requests/day.
#
# How to get a key:
#   1. Go to: https://newsdata.io
#   2. Sign up for free account
#   3. Get your API key from dashboard
#   4. Paste below and also configure in Admin Panel → Config → News API

NEWSDATA_IO_API_KEY=
